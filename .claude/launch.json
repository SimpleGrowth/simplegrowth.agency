{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "simplegrowth",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "-e",
        "const http=require('http'),fs=require('fs'),path=require('path');const root='/Users/stuartwalker/Documents/Clients/Simplegrowth/simplegrowth.agency/.claude/worktrees/intelligent-feistel-8eea9d';const types={'.html':'text/html','.css':'text/css','.js':'application/javascript','.svg':'image/svg+xml','.webp':'image/webp','.png':'image/png','.jpg':'image/jpeg','.json':'application/json','.xml':'application/xml','.txt':'text/plain'};http.createServer((req,res)=>{let p=decodeURIComponent(req.url.split('?')[0]);if(p.endsWith('/'))p+='index.html';const fp=path.join(root,p);if(!fp.startsWith(root)){res.writeHead(403);res.end();return;}fs.readFile(fp,(err,data)=>{if(err){fs.readFile(fp+'.html',(err2,data2)=>{if(err2){res.writeHead(404);res.end('Not found');return;}res.writeHead(200,{'Content-Type':'text/html'});res.end(data2);});return;}const ext=path.extname(fp);res.writeHead(200,{'Content-Type':types[ext]||'application/octet-stream'});res.end(data);});}).listen(3456,()=>console.log('listening on 3456'));"
      ],
      "port": 3456,
      "autoPort": true
    }
  ]
}
